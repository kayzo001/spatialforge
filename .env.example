# SpatialForge backend configuration (copy to .env and adjust).
# All values have sensible defaults; nothing here is required for a CPU run.

# Directory where projects, artifacts and the SQLite database are stored
SPATIALFORGE_DATA_DIR=./data

# Backend host/port
SPATIALFORGE_HOST=127.0.0.1
SPATIALFORGE_PORT=8000

# Absolute path or command name for the COLMAP executable.
# Leave empty to auto-detect on PATH and in common install locations.
SPATIALFORGE_COLMAP_EXECUTABLE=

# Longest image edge used during preprocessing (higher = slower + more memory)
SPATIALFORGE_MAX_IMAGE_SIZE=1600

# Upload limits
SPATIALFORGE_MAX_IMAGES_PER_PROJECT=300
SPATIALFORGE_MAX_UPLOAD_MB=25
SPATIALFORGE_MAX_PROJECT_MB=2000

# Matching strategy for COLMAP: exhaustive (<= N images) or vocab_tree / sequential
SPATIALFORGE_EXHAUSTIVE_MATCH_MAX_IMAGES=120

# Allow skipping processed stages from cache (1) or always rerun (0)
SPATIALFORGE_USE_CACHE=1

# Log level: DEBUG | INFO | WARNING | ERROR
SPATIALFORGE_LOG_LEVEL=INFO
